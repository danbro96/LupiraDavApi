<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose the pure protocol helpers (DavPath, DavProtocol, Basic-credential parsing) for unit testing. -->
    <InternalsVisibleTo Include="LupiraDavApi.UnitTests" />
    <InternalsVisibleTo Include="LupiraDavApi.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- A stateless protocol gateway: no Core project, no Marten, no database. The "domain" is DAV
         protocol translation over the three /dav-backend upstreams (cal, tasks, contact). -->
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.9" />
    <PackageReference Include="Lupira.Clients.ServiceTokens" Version="0.1.0" />
    <PackageReference Include="Lupira.Contracts.Dav" Version="1.0.0" />
    <PackageReference Include="Lupira.Depz" Version="0.1.1" />
    <PackageReference Include="Lupira.Hosting.Defaults" Version="0.1.0" />
    <PackageReference Include="Lupira.Hosting.Health" Version="0.1.0" />
    <PackageReference Include="Lupira.Hosting.Observability" Version="0.1.1" />
  </ItemGroup>

</Project>
